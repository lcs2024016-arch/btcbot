# Copy to btcbot\.env (outside this public repo) or ema915-forward\.env (git-ignored). Never commit it.
DELTA_API_KEY=your_key_here
DELTA_API_SECRET=your_secret_here
# Real orders only when this says yes. Anything else = dry run.
LIVE_TRADING=no
# Tiny account (e.g. Rs 100): always 1 lot, 100x cross, max 3 trades/day, skip if 1 lot risks > 35%
TEST_MODE=yes
# Normal mode limits (ignored in test mode)
MAX_LOTS=5
DAILY_LOSS_PCT=5
# Use IPv4 for all requests (whitelist your IPv4 on the API key)
DELTA_FORCE_IPV4=yes
